# Copy to .env. The local demo has no passwords or production identity provider.
DATABASE_PATH=data/requirements.db
ENABLE_DEMO_LOGIN=true
ENABLE_LLM=false
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=https://api.openai.com/v1
# Explicit opt-in required; masking is heuristic, use synthetic input only.
LLM_ALLOW_EXTERNAL=false
